# BD PARTY LiveKit Cloud Functions Environment Template
#
# IMPORTANT:
# These secrets MUST ONLY be configured in the secure backend environment
# (e.g. Firebase Cloud Functions configuration / Google Cloud Secret Manager).
# NEVER commit the actual secrets or package them into the Android client APK.
#
# To deploy secrets to Firebase Cloud Functions:
#   firebase functions:secrets:set LIVEKIT_API_KEY
#   firebase functions:secrets:set LIVEKIT_API_SECRET
#   firebase functions:secrets:set LIVEKIT_URL
#
# Or in Cloud Functions .env:
# LIVEKIT_API_KEY=your_livekit_api_key_here
# LIVEKIT_API_SECRET=your_livekit_api_secret_here
# LIVEKIT_URL=wss://your-livekit-server-domain.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=
